{
  "_comment": "FitAgent MCP Server — Claude Desktop Integration Config",
  "_instructions": [
    "1. Copy this file to your Claude Desktop config location:",
    "   Windows: %APPDATA%\\Claude\\claude_desktop_config.json",
    "   macOS:   ~/Library/Application Support/Claude/claude_desktop_config.json",
    "2. Replace YOUR_PROJECT_PATH with the absolute path to FitAgent/backend",
    "3. Replace YOUR_USER_ID with a real user ID from the FitAgent database",
    "   (or leave empty to use the MCP_DEMO_USER_ID env var)",
    "4. Ensure Python 3.10+ is installed and 'python' is on your PATH",
    "5. Restart Claude Desktop after saving the config"
  ],

  "mcpServers": {
    "fitagent": {
      "command": "python",
      "args": ["-m", "app.mcp.server"],
      "cwd": "YOUR_PROJECT_PATH\\backend",
      "env": {
        "PYTHONPATH": "YOUR_PROJECT_PATH\\backend",
        "MCP_DEMO_USER_ID": ""
      }
    }
  },

  "_windows_example": {
    "mcpServers": {
      "fitagent": {
        "command": "python",
        "args": ["-m", "app.mcp.server"],
        "cwd": "D:\\ForOffer\\Agent\\FitnessAgent\\backend",
        "env": {
          "PYTHONPATH": "D:\\ForOffer\\Agent\\FitnessAgent\\backend",
          "MCP_DEMO_USER_ID": "YOUR_USER_ID_HERE"
        }
      }
    }
  },

  "_macos_example": {
    "mcpServers": {
      "fitagent": {
        "command": "python3",
        "args": ["-m", "app.mcp.server"],
        "cwd": "/Users/xxx/FitAgent/backend",
        "env": {
          "PYTHONPATH": "/Users/xxx/FitAgent/backend",
          "MCP_DEMO_USER_ID": "YOUR_USER_ID_HERE"
        }
      }
    }
  }
}
